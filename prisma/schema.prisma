// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RolUsuario {
  ADMIN
  TECNICO
}

enum EstadoOrden {
  PENDIENTE
  EN_DIAGNOSTICO
  EN_REPARACION
  LISTO_ENTREGA
  ENTREGADO
  CANCELADO
}

model Usuario {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  nombre       String
  rol          RolUsuario  @default(TECNICO)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  ordenesAsignadas OrdenServicio[]

  @@map("usuarios")
}

model Cliente {
  id        String   @id @default(uuid())
  dniCuit   String   @unique
  nombre    String
  telefono  String
  email     String?
  direccion String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipos   Equipo[]

  @@index([dniCuit])
  @@index([nombre])
  @@map("clientes")
}

model Equipo {
  id          String   @id @default(uuid())
  clienteId   String
  tipo        String   // ej: Notebook, Celular, PC, Impresora
  marca       String
  modelo      String
  numeroSerie String?
  accesorios  String?  // ej: Cargador, funda, cable power
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cliente     Cliente         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  ordenes     OrdenServicio[]

  @@index([clienteId])
  @@index([numeroSerie])
  @@map("equipos")
}

model OrdenServicio {
  id                 String       @id @default(uuid())
  numeroOrden        String       @unique // ej: OT-0001
  equipoId           String
  tecnicoAsignadoId  String?
  problemaReportado  String
  diagnostico        String?
  estado             EstadoOrden  @default(PENDIENTE)
  costoEstimado      Decimal?     @db.Decimal(10, 2)
  costoFinal         Decimal?     @db.Decimal(10, 2)
  fechaIngreso       DateTime     @default(now())
  fechaEgreso        DateTime?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  equipo             Equipo       @relation(fields: [equipoId], references: [id], onDelete: Restrict)
  tecnicoAsignado    Usuario?     @relation(fields: [tecnicoAsignadoId], references: [id], onDelete: SetNull)

  @@index([numeroOrden])
  @@index([equipoId])
  @@index([estado])
  @@map("ordenes_servicio")
}
